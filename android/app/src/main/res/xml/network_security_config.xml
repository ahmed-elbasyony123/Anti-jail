<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext HTTP/WS traffic is permitted so that local testing relays (127.0.0.1, 10.0.2.2)
  and .onion hidden services (where end-to-end encryption is handled inside Tor)
  are never blocked by Android's network security policy.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
