{
  "name": "ghostkey-blind-relay",
  "version": "2.2.0",
  "description": "Blind store-and-forward relay for OpenPGP messages (RAM-only queues), designed to run behind a Tor onion service",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "check": "node --check server.js",
    "test": "node --test test/relay.test.js test/core.test.mjs test/ui.test.mjs test/web-e2e.test.mjs"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "jsdom": "^31.0.1",
    "openpgp": "^6.3.2"
  }
}
